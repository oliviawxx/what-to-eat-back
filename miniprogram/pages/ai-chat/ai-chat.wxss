.page-ai-chat {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fffef5;
}

.chat-header {
  padding: 32rpx;
  background: #fdf8f0;
  border-bottom: 1rpx solid #eee;
}

.ai-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.ai-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.message-list {
  flex: 1;
  padding: 24rpx 24rpx 24rpx 24rpx;
  box-sizing: border-box;
}

/* 消息行基础通用样式 */
.msg {
  display: flex;
  margin-bottom: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.msg-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

/* --- AI 布局 (靠左) --- */
.msg-ai {
  justify-content: flex-start;
}
.msg-ai .msg-avatar {
  margin-right: 16rpx;
}
.msg-ai .msg-bubble {
  background: #fff;
  color: #333;
  border-radius: 0 20rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

/* --- 用户布局 (靠右) --- */
.msg-user {
  justify-content: flex-end; /* 整体推向右边 */
}
.msg-user .msg-avatar {
  margin-left: 16rpx; /* 头像在气泡右边，所以左边留间距 */
}
.msg-user .msg-bubble {
  background: #8B4513;
  color: #fff;
  border-radius: 20rpx 0 20rpx 20rpx; /* 右上角直角，对接头像 */
}

/* 底部输入框 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.btn-send {
  width: 72rpx;
  height: 72rpx;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-send-img {
  width: 56rpx;
  height: 56rpx;
}