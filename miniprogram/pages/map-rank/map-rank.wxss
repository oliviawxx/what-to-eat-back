.page-map {
  min-height: 100vh;
  padding-bottom: 200rpx;
  background: #fffef5;
  box-sizing: border-box;
}

/* 同一行：模式选择（左，含红条+地图/列表）+ 筛选条件（右） */
.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 32rpx 20rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.header-title-row {
  display: flex;
  align-items: center;
}

.title-bar {
  width: 8rpx;
  height: 28rpx;
  background: #d2a679;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.title-bar.red {
  background: #c0392b;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5d4037;
}

.mode-options {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.mode-option {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.mode-option.active {
  color: #333;
  font-weight: 500;
}

.arrow-left {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-right: 10rpx solid #c0392b;
}

.header-right {
  display: flex;
  align-items: center;
}

.header-right .title-bar {
  margin-right: 12rpx;
}

.chevron {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 14rpx solid #5d4037;
}

.filter-chevron {
  border-top-color: #5d4037;
}

/* 主内容 */
.content {
  margin: 0 32rpx 32rpx;
  min-height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: transparent;
}

/* 地图模式：地图与按钮分离，避免原生 map 遮挡按钮 */
.map-wrap {
  width: 100%;
  border-radius: 16rpx 16rpx 0 0;
  overflow: hidden;
  background: #f5f5f5;
}

.map-component {
  width: 100%;
  height: 820rpx;
  display: block;
}

/* 按钮区独立于 map-wrap 外，自带背景，防止被地图盖住 */
.map-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0 0;
  margin-top: 0;
  background: #fffef5;
  border-radius: 0 0 16rpx 16rpx;
}

.map-action-btn {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: transparent;
}

.map-action-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
}

.map-action-text {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  font-weight: 500;
  color: #5d4037;
}

/* 列表模式：约饭卡片列表 */
.list-scroll {
  height: calc(100vh - 280rpx);
  position: relative;
}

.list-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(255,248,220,0.6) 0%, rgba(255,248,235,0.5) 100%);
  pointer-events: none;
}

.event-cards {
  position: relative;
  padding: 16rpx 0 120rpx;
}

.event-card {
  background: #fffef8;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.card-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8e0d5;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.card-user {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.card-count {
  font-size: 26rpx;
  color: #666;
}

.card-details {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.card-line {
  font-size: 26rpx;
  color: #555;
  line-height: 1.45;
}

.card-actions {
  display: flex;
  gap: 24rpx;
}

.card-btn {
  flex: 1;
  height: 90rpx;
  padding: 0;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}

.card-btn::after {
  border: none;
}

.card-btn-icon {
  width: 100%;
  height: 100%;
}

/* 约饭详情弹窗 */
.detail-modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 110;
}

.detail-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%) scale(0.95);
  z-index: 111;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
  border-radius: 24rpx;
  background: #fffef8;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.15);
}

.detail-modal--show {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(-50%) scale(1);
}

.detail-modal-inner {
  padding: 32rpx 28rpx 28rpx;
}

.detail-card-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-card-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8e0d5;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.detail-card-user {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.detail-card-count {
  font-size: 26rpx;
  color: #666;
}

.detail-card-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.detail-line {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}

.detail-card-actions {
  display: flex;
  gap: 24rpx;
}

.detail-btn {
  flex: 1;
  height: 88rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 12rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-btn::after {
  border: none;
}

.detail-btn-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* 筛选：从上方弹出的遮罩 */
.filter-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
}

/* 筛选面板：从顶部滑出，浅黄圆角 */
.filter-panel {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: -100%;
  border-radius: 24rpx 24rpx 0 0;
  background: #fffef8;
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.12);
  z-index: 101;
  transition: top 0.25s ease;
  max-height: 80vh;
  overflow: hidden;
}

.filter-panel--show {
  top: 120rpx;
}

.filter-inner {
  padding: 32rpx 24rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.filter-section {
  margin-bottom: 36rpx;
}

.filter-label-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-bar {
  width: 8rpx;
  height: 28rpx;
  background: #c0392b;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.filter-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.chip {
  padding: 16rpx 28rpx;
  background: #fff;
  border: 2rpx solid #d2a679;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}

.chip--active {
  background: #f5e6c8;
  border-color: #d2a679;
  color: #5d4037;
}

.filter-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
  padding-top: 24rpx;
}

.filter-btn {
  flex: 1;
  height: 88rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 44rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-btn::after {
  border: none;
}

.filter-btn-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
