.page-template-edit {
  min-height: 100vh;
  padding: 32rpx 32rpx 180rpx;
  background: #fffef5;
  box-sizing: border-box;
}

.section {
  margin-bottom: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-bar {
  width: 8rpx;
  height: 28rpx;
  background: #8B4513;
  margin-right: 12rpx;
  border-radius: 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.template-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.template-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.template-row:last-child {
  border-bottom: none;
}

.template-row-left {
  flex: 1;
  min-width: 0;
}

.template-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.template-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.tpl-arrow {
  font-size: 32rpx;
  color: #999;
}

.picker-value {
  padding: 24rpx;
  background: #fff8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.input-field {
  display: block;
  width: 100%;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #fff8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.input-field:last-child {
  margin-bottom: 0;
}

.textarea-field {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  background: #fff8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #333;
}

.tag-add {
  background: #f0e6d8;
  color: #8B4513;
}

.btn-wrap {
  margin-top: 48rpx;
  padding: 0 32rpx;
}

.btn-save {
  width: 100%;
  height: 96rpx;
  padding: 0;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-save::after {
  border: none;
}

.btn-save-img {
  width: 100%;
  height: 100%;
}
