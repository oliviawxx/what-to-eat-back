.page-publish {
  min-height: 100vh;
  padding-bottom: 200rpx;
  background: #fffef5;
}

/* 自定义顶栏 */
.nav-bar {
  background: #fdf8f0;
  flex-shrink: 0;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
}

.nav-back {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-arrow {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
}

.nav-title {
  position: absolute;
  left: 80rpx;
  right: 80rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-right {
  min-width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.nav-right-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 约饭编辑容器 */
.dine-container {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.dine-card {
  background: #fdf8f0;
  border-radius: 24rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  margin-top: 32rpx;
}

.section-title:first-child {
  margin-top: 0;
}

/* 商家信息卡片 */
.merchant-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 8rpx;
}

.merchant-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.merchant-edit {
  padding: 8rpx;
}

.merchant-edit-icon {
  width: 36rpx;
  height: 36rpx;
}

.merchant-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.merchant-tag {
  font-size: 24rpx;
  color: #c17a3a;
  background: rgba(193, 122, 58, 0.12);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.merchant-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.merchant-row:last-child {
  margin-bottom: 0;
}

.merchant-label {
  flex-shrink: 0;
  width: 140rpx;
  color: #666;
}

.merchant-value,
.merchant-price {
  flex: 1;
  color: #333;
}

.merchant-addr-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.merchant-nav {
  color: #c17a3a;
  flex-shrink: 0;
}

.merchant-row--link {
  align-items: center;
}

.merchant-arrow {
  font-size: 32rpx;
  color: #999;
}

/* 约饭表单行 */
.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.form-row .form-label {
  flex-shrink: 0;
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 2rpx solid #e8d5b5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.form-textarea-dine {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background: #fff;
  border: 2rpx solid #e8d5b5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-picker {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 2rpx solid #e8d5b5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 24rpx;
}

.dine-tags-scroll {
  width: 100%;
  margin-bottom: 40rpx;
  height: 72rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-row-inner {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  padding: 4rpx 0;
}

.tag-row-inner .tag-item {
  flex-shrink: 0;
}

.tag-item {
  padding: 12rpx 24rpx;
  background: rgba(193, 122, 58, 0.12);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #c17a3a;
}

.tag-item--add {
  background: transparent;
  border: 2rpx dashed #daa520;
  color: #c17a3a;
}

/* 约饭编辑-添加标签弹层 */
.add-tag-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 150;
}

.add-tag-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 151;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 24rpx;
}

.add-tag-modal-inner {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.add-tag-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.add-tag-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.add-tag-actions {
  display: flex;
  gap: 24rpx;
  justify-content: flex-end;
}

.add-tag-btn {
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.add-tag-btn--cancel {
  background: #f0f0f0;
  color: #666;
}

.add-tag-btn--ok {
  background: #8B4513;
  color: #fff;
}

.dine-publish-wrap {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.dine-publish-btn {
  width: 100%;
  max-width: 400rpx;
  height: 96rpx;
  padding: 0;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dine-publish-btn::after {
  border: none;
}

.dine-publish-btn-img {
  width: 100%;
  height: 100%;
}

/* 评价容器 */
.review-container {
  padding: 32rpx 24rpx;
}


/* 星评 */
.star-rating {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.stars {
  display: flex;
  gap: 16rpx;
}

.star {
  font-size: 56rpx;
  cursor: pointer;
  transition: color 0.2s;
}

/* 评价表单 */
.review-form {
  margin-bottom: 40rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #fff;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 上传选项 */
.upload-options {
  display: flex;
  gap: 20rpx;
}

.upload-btn {
  flex: 1;
  padding: 24rpx;
  background: #fff9f0;
  border: 2rpx dashed #daa520;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666;
  cursor: pointer;
}

.upload-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 发布按钮容器 */
.publish-btn-container {
  display: flex;
  justify-content: center;
  margin-top: 60rpx;
}

.publish-btn {
  width: 300rpx;
  height: 100rpx;
  padding: 0;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-btn::after {
  border: none;
}

.publish-btn-img {
  width: 100%;
  height: 100%;
}
